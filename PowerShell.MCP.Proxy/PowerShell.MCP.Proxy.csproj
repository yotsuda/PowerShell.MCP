<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Pin the bundled runtime pack to the latest patched 9.0.x. Dependabot
         flags this file for every .NET / ASP.NET Core advisory against the
         pinned pack (9.0.19/9.0.20: 14 alerts, CVE-2026-58280 … 96236;
         9.0.21: CVE-2026-111497; 9.0.22: CVE-2026-109475, 109476, 114149);
         raising this to the first patched version closes them. -->
    <RuntimeFrameworkVersion>9.0.23</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.17.1.0</Version>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>

    <!-- Native AOT. An MCP client starts a proxy for every session and gives it
         a time limit (Claude Code: 30 s), and the trimmed single-file build spent
         its start-up JIT-compiling: trimming rewrites the runtime's assemblies
         and drops their precompiled code. Measured on Windows (2026-11-19):
         initialize answered in 0.35-0.67 s with tools/list, 0.2-0.3 s CPU,
         against 1.6-2.0 s and 1.5-1.7 s CPU (ReadyToRun: 0.9 s, 22.6 MB).
         Native AOT does not compile across operating systems, so each RID is
         published on its own OS: release.yml builds them; Build-AllPlatforms.ps1
         builds win-x64 only. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType>embedded</DebugType>

    <!-- Suppress warnings (trimming-related) -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerShell.MCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP SDK -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <!-- Minimal dependency-injection set -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
  </ItemGroup>

  <!-- Trimming settings (Native AOT trims too): protect required assemblies -->
  <ItemGroup>
    <TrimmerRootAssembly Include="PowerShell.MCP.Proxy" />
    <TrimmerRootAssembly Include="ModelContextProtocol" />
    <TrimmerRootAssembly Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <!-- Resource file settings -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\**\*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\PromptDescriptions.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PromptDescriptions.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\PromptDescriptions.resx">
      <LastGenOutput>PromptDescriptions.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Add prompt templates as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Prompts\Templates\*.md" />
  </ItemGroup>

</Project>
